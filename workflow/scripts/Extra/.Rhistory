) +
# C. Couleurs et Alpha
scale_alpha_manual(values = c(1, 0.4), guide = "none") +
scale_color_manual(
values = c("#B2182BFF", "#2166ACFF"),
name = "Occurrence in :"
) +
scale_fill_manual(
values = c("T1" = "#FDDBC7FF", "T2" = "#D1E5F0FF", "S1 & S2" = "#009E73"),
drop = FALSE,
na.translate = FALSE,
name = "First record in : "
) +
# D. Échelle et Flèche (ggspatial)
# IMPORTANT: Ces fonctions doivent être ajoutées APÈS les géométries
ggspatial::annotation_scale(
location = "bl",
bar_cols = c("grey60", "white"),
width_hint = 0.15 # Ajustez la taille de la barre
) +
ggspatial::annotation_north_arrow(
location = "bl",
which_north = "true",
pad_x = unit(0.4, "in"),
pad_y = unit(0.4, "in")
) +
# E. Système de coordonnées (C'est ici que la magie opère)
# On force la projection Robinson et on définit les limites si besoin
coord_sf(
crs = st_crs(map_polygons), # Utilise la CRS de la carte projetée
datum = NULL, # Ignore le datum pour éviter les conflits
expand = FALSE
) +
# F. Thème et Facettes
labs(x = "", y = "") +
theme_bw() +
theme(
axis.text = element_blank(),
axis.title = element_blank(),
strip.text.x = element_text(size = 13),
legend.text = element_text(size = 13),
legend.title = element_text(size = 13, face = "bold"),
legend.position = "bottom",
panel.spacing = unit(1, "lines") # Espacement entre les facettes
) +
facet_wrap(~Taxa)
LH_map
