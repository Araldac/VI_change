map_polygons <- antmaps_pol_R # C'est déjà en Robinson
# 2. S'assurer que les points (all_coords_ben) sont aussi projetés pour l'affichage
# Note: geom_point avec x/y (lon/lat) peut être tracé sur une carte projetée
# si on utilise coord_sf, mais il est plus propre de projeter les points aussi.
# Cependant, si vous voulez garder les points en lon/lat, ggplot2 les projette automatiquement
# si vous utilisez coord_sf et que les données d'entrée sont en WGS84.
LH_map <- ggplot() +
# A. Fond de carte (Doit être en Robinson)
geom_sf(data = map_polygons, fill = "grey93", color = "white") +
# B. Points d'observation (All_coords_ben)
# On filtre pour Linepithema humile et on projette les coordonnées si nécessaire
# Si all_coords_ben est un data.frame avec lon/lat, ggplot2 les projette via coord_sf
geom_point(
data = all_coords_ben[all_coords_ben$Taxa == "Linepithema humile", ],
aes(x = decimallongitude, y = decimallatitude, color = S_new, alpha = S_new),
size = 2
) +
# C. Couleurs et Alpha
scale_alpha_manual(values = c(1, 0.4), guide = "none") +
scale_color_manual(
values = c("#B2182BFF", "#2166ACFF"),
name = "Occurrence in :"
) +
scale_fill_manual(
values = c("T1" = "#FDDBC7FF", "T2" = "#D1E5F0FF", "S1 & S2" = "#009E73"),
drop = FALSE,
na.translate = FALSE,
name = "First record in : "
) +
# D. Échelle et Flèche (ggspatial)
# IMPORTANT: Ces fonctions doivent être ajoutées APÈS les géométries
ggspatial::annotation_scale(
location = "bl",
bar_cols = c("grey60", "white"),
width_hint = 0.15 # Ajustez la taille de la barre
) +
ggspatial::annotation_north_arrow(
location = "bl",
which_north = "true",
pad_x = unit(0.4, "in"),
pad_y = unit(0.4, "in")
) +
# E. Système de coordonnées (C'est ici que la magie opère)
# On force la projection Robinson et on définit les limites si besoin
coord_sf(
crs = st_crs(map_polygons), # Utilise la CRS de la carte projetée
datum = NULL, # Ignore le datum pour éviter les conflits
expand = FALSE
) +
# F. Thème et Facettes
labs(x = "", y = "") +
theme_bw() +
theme(
axis.text = element_blank(),
axis.title = element_blank(),
strip.text.x = element_text(size = 13),
legend.text = element_text(size = 13),
legend.title = element_text(size = 13, face = "bold"),
legend.position = "bottom",
panel.spacing = unit(1, "lines") # Espacement entre les facettes
) +
facet_wrap(~Taxa)
